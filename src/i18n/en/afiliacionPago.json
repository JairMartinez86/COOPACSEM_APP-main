          "label": "Deposit Detail",
          "tooltip": "Required field"
        }
      },
      "validations": {
        "Monto": {
          "data": {
            "1": {
              "rule": "NUM>",
              "value": "0",
              "msj": "Enter an amount greater than 0"
            }
          }
        },
        "BancoCodigo": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Select a bank"
            }
          }
        },
        "NoDeposito": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^[0-9]+$",
              "msj": "Enter the deposit number"
            }
          }
        },
        "FechaDeposito": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter a valid date"
            },
            "2": {
              "rule": "DATE<=",
              "value": "{FechaServidor}",
              "when": "",
              "msj": "The date must be less than or equal to the server date."
            }
          }
        },
        "Observacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter an observation"
            }
          }
        }
      }
    },
