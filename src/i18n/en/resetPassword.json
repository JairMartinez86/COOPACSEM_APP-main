{
  "resetPassword": {
    "title": "Reset password",
    "subtitle": "Choose a secure password that you have not used before.",
    "newPassword": "New password",
    "newPasswordPlaceholder": "New password",
    "confirmPassword": "Confirm password",
    "confirmPasswordPlaceholder": "Confirm password",
    "resetButton": "Reset password",
    "backToLogin": "Back to login",
    "rights": "All rights reserved",
    "passwordsDoNotMatch": "Passwords do not match.",
    "invalidToken": "The recovery link is invalid or has expired.",
    "remainingTime": "Remaining time:",
    "expired": "The recovery link has expired.",
    "form": {
      "fieldMeta": {
        "newPassword": {
          "label": "Password",
          "tooltip": "Required field"
        },
        "confirmPassword": {
          "label": "Password",
          "tooltip": "Required field"
        }
      },
      "validations": {
        "newPassword": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "The new password is required"
            },
            "2": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{newPassword}!=''",
              "msj": "The password must have at least {value} characters",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "3": {
              "rule": "IGUAL",
              "value": "{confirmPassword}",
              "when": "{newPassword}!='' && {confirmPassword}!=''",
              "msj": "Passwords do not match",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "confirmPassword": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Password confirmation is required"
            },
            "2": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{confirmPassword}!=''",
              "msj": "The password must have at least {value} characters",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "3": {
              "rule": "IGUAL",
              "value": "{newPassword}",
              "when": "{newPassword}!='' && {confirmPassword}!=''",
              "msj": "Passwords do not match",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        }
      }
    }
  }
}