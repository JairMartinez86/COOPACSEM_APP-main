        "theme": {
          "label": "User",
          "tooltip": "Required field",
          "tooltipIconClass": ""
        },
        "maxSessions": {
          "label": "User",
          "tooltip": "Required field",
          "tooltipIconClass": ""
        },
        "defaultLandingPage": {
          "label": "User",
          "tooltip": "Optional field",
          "tooltipIconClass": ""
        },
        "active": {
          "label": "User",
          "tooltip": "Optional field",
          "tooltipIconClass": ""
        },
        "enableTwoFactorLogin": {
          "label": "User",
          "tooltip": "Optional field",
          "tooltipIconClass": ""
        },
        "enableAuditEmailNotifications": {
          "label": "Enable email notifications",
          "tooltip": ""
        }
      },
      "validations": {
        "firstName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Required field",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "lastName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Required field",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "email": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{enableTwoFactorLogin}=true",
              "msj": "Email address is required",
              "classIconSuccess": "",
              "classIconError": ""
            },
            "2": {
              "rule": "EMAIL",
              "when": "{enableTwoFactorLogin}=true || {enableAuditEmailNotifications}=true  || {email}!=''",
              "msj": "Enter a valid email",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "role": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Select a role",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "password": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{password}!=''",
              "msj": "The password must have at least {value} characters",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "LEN<=",
              "value": "100",
              "when": "{password}!=''",
              "msj": "The password allows a maximum of {value} characters only",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "confirmPassword": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{confirmPassword}!=''",
              "msj": "The password must have at least {value} characters",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "IGUAL",
              "value": "{password}",
              "when": "{password}!='' && {confirmPassword}!=''",
              "msj": "Passwords do not match",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "gender": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Select a sex",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "mobile": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "when": "{mobile}!=''",
              "msj": "Enter a valid mobile number"
            }
          }
        },
        "phoneNumber": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{phoneNumber}!=''",
              "msj": "Enter a valid phone number"
            }
          }
        },
        "language": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Select a language",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "address": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": "Address is required"
            }
          }
        },
        "theme": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Select a visual style",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "enableTwoFactorLogin": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": "",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "maxSessions": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "msj": "Only positive numbers are allowed",
              "classIconSuccess": "",
              "classIconError": ""
            },
            "2": {
              "rule": "NUM<=",
              "value": "5",
              "msj": "No more than {value} active sessions are allowed",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        }
      }
    },
