      "validations": {
        "CompanyName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Company name is required"
            }
          }
        },
        "TradeName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Trade name is required"
            }
          }
        },
        "Ruc": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Tax ID (RUC) is required"
            }
          }
        },
        "BusinessType": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a business type"
            }
          }
        },
        "Status": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a status"
            }
          }
        },
        "Description": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Description is required"
            }
          }
        },
        "Phone": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{Phone}!=''",
              "msj": "Enter a valid phone number"
            }
          }
        },
        "Mobile": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "when": "{Mobile}!=''",
              "msj": "Enter a valid mobile number"
            }
          }
        },
        "Email": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Email is required"
            },
            "2": {
              "rule": "EMAIL",
              "when": "{Email}!=''",
              "msj": "Enter a valid email address"
            }
          }
        },
        "Website": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Website is required"
            }
          }
        },
        "Address": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Address is required"
            }
          }
        },
        "Country": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a country"
            }
          }
        },
        "City": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "City is required"
            }
          }
        },
        "DateFormat": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a date format"
            }
          }
        },
        "Currency": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a currency"
            }
          }
        },
        "DecimalSeparator": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a decimal separator"
            }
          }
        },
        "ThousandSeparator": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "You must select a thousands separator"
            }
          }
        },
        "AffiliationCost": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "The affiliation amount must be greater than 0"
            }
          }
        },
        "OrdinaryCapitalPercentage": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "The ordinary capital percentage must be greater than or equal to 0"
            },
            "2": {
              "rule": "NUM({OtherDeferredIncomePercentage}+{OrdinaryCapitalPercentage})=",
              "value": "100",
              "when": "",
              "msj": "The ordinary capital percentage and other deferred income must add up to 100"
            }
          }
        },
        "OtherDeferredIncomePercentage": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "The other deferred income percentage must be greater than or equal to 0"
            },
            "2": {
              "rule": "NUM({OtherDeferredIncomePercentage}+{OrdinaryCapitalPercentage})=",
              "value": "100",
              "when": "",
              "msj": "The ordinary capital percentage and other deferred income must add up to 100"
            }
          }
        },
        "AffiliationAccount": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter the affiliation ledger account"
            }
          }
        },
        "OrdinaryCapitalAccount": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter the ordinary capital ledger account"
            }
          }
        },
        "OtherDeferredIncomeAccount": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter the other deferred income account"
            }
          }
        },
        "CurrentAccount": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter the current ledger account"
            }
          }
        },
        "ChristmasAccount": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Enter the Christmas ledger account"
            }
          }
        },
        "SmtpHost": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "SMTP server is required"
            }
          }
        },
        "SmtpPort": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "SMTP port is required"
            },
            "2": {
              "rule": "NUM>=",
              "value": "1",
              "when": "{SmtpPort}!=''",
              "msj": "SMTP port must be greater than or equal to {value}"
            }
          }
        },
        "SmtpFrom": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Sender email is required"
            },
            "2": {
              "rule": "EMAIL",
              "when": "{SmtpFrom}!=''",
              "msj": "Enter a valid sender email address"
            }
          }
        },
        "SmtpUsername": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "SMTP username is required"
            }
          }
        },
        "SmtpPassword": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "SMTP password is required"
            }
          }
        },
        "TwoFactorCodeExpirationMinutes": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "The 2FA code expiration time is required"
            },
            "2": {
              "rule": "NUM>=",
              "value": "1",
              "when": "{TwoFactorCodeExpirationMinutes}!=''",
              "msj": "The minimum allowed time is {value} minute"
            }
          }
        },
        "PasswordResetExpirationMinutes": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "The password reset time is required"
            },
            "2": {
              "rule": "NUM>=",
              "value": "1",
              "when": "{PasswordResetExpirationMinutes}!=''",
              "msj": "The minimum allowed time is {value} minute"
            }
          }
        },
        "JwtExpiresMinutes": {
          "data": {
            "1": {
              "rule": "LEN>",
