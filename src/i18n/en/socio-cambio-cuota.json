      "labels": {
        "saving": "Savings",
        "withdrawal": "Withdrawal",
        "interest": "Interest"
      }
    },
    "form": {
      "fieldMeta": {
        "TipoCuenta": {
          "label": "Account Type",
          "tooltip": "Required field"
        },
        "TipoMovimiento": {
          "label": "Movement Type",
          "tooltip": "Required field"
        },
        "CuotaActual": {
          "label": "Current Quota",
          "tooltip": "Required field"
        },
        "NuevaCuota": {
          "label": "New Quota",
          "tooltip": "Required field"
        },
        "Diferencia": {
          "label": "Difference",
          "tooltip": "Calculated field"
        },
        "Vigencia": {
          "label": "Start Date",
          "tooltip": "Required field"
        },
        "AplicaDesde": {
          "label": "Apply From",
          "tooltip": "Required field"
        },
        "Observacion": {
          "label": "Observation",
          "tooltip": "Optional field"
        }
      },
      "validations": {
        "TipoCuenta": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Select the account type"
            }
          }
        },
        "FechaServidor": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": ""
            }
          }
        },
        "TipoMovimiento": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Select the movement type"
            }
          }
        },
        "CuotaActual": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        },
        "NuevaCuota": {
          "data": {
            "1": {
              "rule": "NUM>",
              "value": "0",
              "when": "",
              "msj": "The new quota must be greater than 0"
            },
            "2": {
              "rule": "NUM>",
              "value": "{CuotaActual}",
              "when": "{TipoMovimiento}=incremento",
              "msj": "The new quota must be greater than the current one"
            },
            "3": {
              "rule": "NUM<",
              "value": "{CuotaActual}",
              "when": "{TipoMovimiento}=disminucion",
              "msj": "The new quota must be less than the current one"
            }
          }
        },
        "Vigencia": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter the start date"
            },
            "2": {
              "rule": "DATE>=",
              "value": "{FechaServidor}",
              "when": "",
              "msj": "The date must be greater than or equal to the system date"
            }
          }
        },
        "AplicaDesde": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Select when to apply the movement"
            }
          }
        },
        "Observacion": {
          "data": {
            "1": {
              "rule": "LEN<=",
              "value": "500",
              "when": "",
              "msj": "Observations must not exceed {value} characters"
            }
          }
        }
      }
    }
  }
}