      "validations": {
        "idCompany": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Select a company" }
          }
        },
        "codigo": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Enter a code" }
          }
        },
        "tratamiento": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Select an option (Salutation)" }
          }
        },
        "nombre": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Supplier name is required" }
          }
        },
        "sector": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Select a sector" }
          }
        },
        "tipoIdentificacion": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Identification type is required" }
          }
        },
        "numeroIdentificacion": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Identification number is required" }
          }
        },
        "paisId": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Select a country" }
          }
        },
        "telefono": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{telefono}!=''",
              "msj": "Enter a valid phone number"
            }
          }
        },
        "planCuentaNombre": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Account plan is required" }
          }
        },
        "cuentaContableNombre": {
          "data": {
            "1": { "rule": "LEN>", "value": "0", "when": "", "msj": "Accounting account is required" }
          }
        },
        "direccion": {
          "data": {
            "1": { "rule": "LEN>=", "value": "0", "when": "", "msj": "" }
          }
        },
        "correo": {
          "data": {
            "1": {
              "rule": "EMAIL",
              "value": "",
              "when": "{correo}!=''",
              "msj": "Enter a valid email address"
            }
          }
        }
      }
