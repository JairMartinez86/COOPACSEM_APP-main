              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Enter the position"
            }
          }
        },
        "fechaIngreso": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter the position"
            }
          }
        },
        "numeroIp": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        },
        "correoLaboral": {
          "data": {
            "1": {
              "rule": "EMAIL",
              "value": "",
              "when": "{correoLaboral}!=''",
              "msj": "Enter a valid email address"
            }
          }
        },
        "jefeInmediato": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Enter the immediate supervisor name"
            }
          }
        },
        "ingresosMensuales": {
          "data": {
            "1": {
              "rule": "NUM>",
              "value": "0",
              "when": "",
              "msj": "Enter a positive value (Monthly income)"
            }
          }
        },
        "otrosIngresos": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "Enter a positive value (Other income)"
            }
          }
        },
        "ingresosAnuales": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "Enter a positive value (Total annual income)"
            }
          }
        },
        "conyugeNombreCompleto": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{estadoCivil}='casado' || {estadoCivil}='union_libre'",
              "msj": "Enter the full name"
            }
          }
        },
        "conyugeTipoIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{estadoCivil}='casado' || {estadoCivil}='union_libre'",
              "msj": "Select an identification type"
            }
          }
        },
        "conyugeNumeroIdentificacion": {
          "data": {
            "1": {
              "rule": "IF({estadoCivil}='casado' || {estadoCivil}='union_libre')->{3,4,5,6}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "2": {
              "rule": "IF(LEN({conyugeNumeroIdentificacion})>0)->{3,4,5,6}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "3": {
              "rule": "LEN>",
              "value": "0",
              "when": "{conyugeTipoIdentificacion} !='cedula'",
              "msj": "The spouse ID number is required"
            },
            "4": {
              "rule": "IGUAL!=",
              "value": "{numeroIdentificacion}",
              "when": "{conyugeTipoIdentificacion}='cedula'",
              "msj": "The spouse ID number cannot be the same as the member’s"
            },
            "5": {
              "rule": "REGEX",
              "when": "{conyugeTipoIdentificacion}='cedula' || {conyugeTipoIdentificacion}='residencia'",
              "value": "^[0-9]+[A-Za-z]$",
              "msj": "Only numbers and one letter at the end are allowed"
            },
            "6": {
              "rule": "LEN==",
              "when": "{conyugeTipoIdentificacion}='residencia' || {conyugeTipoIdentificacion}='cedula'",
              "value": "14",
              "msj": "It must have exactly 14 characters"
            }
          }
        },
        "conyugePaisNacimiento": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{estadoCivil}='casado' || {estadoCivil}='union_libre'",
              "msj": "Select the country of birth"
            }
          }
        },
        "conyugeNacionalidadId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{estadoCivil}='casado' || {estadoCivil}='union_libre'",
              "msj": "Enter the nationality"
            }
          }
        },
        "cuentaCorrienteActiva": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        },
        "cuentaCorrienteMontoCuota": {
          "data": {
            "1": {
              "rule": "NUM>",
              "value": "0",
              "when": "{cuentaCorrienteActiva} = true",
              "msj": "Enter a valid value"
            }
          }
        },
        "cuentaCorrienteFechaInicioDeduccion": {
          "data": {
             "1": {
              "rule": "IF({bloquearAhorroCorriente}=false)->{2,3,4}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "2": {
              "rule": "LEN>",
              "value": "0",
              "when": "{cuentaCorrienteActiva}=true",
              "msj": "Enter the deduction date (Checking account)"
            },
            "3": {
              "rule": "DAYIN_VALID_MONTH",
              "value": "15,30",
              "when": "{cuentaCorrienteActiva}=true && LEN>0",
              "msj": "The date must be the 15th or the last allowed day of the month"
            },
            "4": {
              "rule": "DATE>",
              "value": "{fechaIngreso}",
              "when": "{cuentaCorrienteActiva}=true && LEN>0 && {fechaIngreso}!=''",
              "msj": "The deduction date must be later than the start date"
            }
          }
        },
        "cuentaNavidenaMontoCuota": {
          "data": {
            "1": {
              "rule": "NUM>",
              "value": "0",
              "when": "{cuentaNavidenaActiva} = true",
              "msj": "Enter a valid value"
            }
          }
        },
        "cuentaNavidenaFechaInicioDeduccion": {
          "data": {
            "1": {
              "rule": "IF({bloquearAhorroNavidena}=false)->{2,3,4}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "2": {
              "rule": "LEN>",
              "value": "0",
              "when": "{cuentaNavidenaActiva}=true",
              "msj": "Enter the deduction date (Christmas account)"
            },
            "3": {
              "rule": "DAYIN_VALID_MONTH",
              "value": "15,30",
              "when": "{cuentaNavidenaEsMensual}=true && LEN>0",
              "msj": "The date must be the 15th or the last allowed day of the month"
            },
            "4": {
              "rule": "DATE>",
              "value": "{fechaIngreso}",
              "when": "{cuentaNavidenaActiva}=true && LEN>0 && {fechaIngreso}!=''",
              "msj": "The deduction date must be later than the start date"
            }
          }
        },
        "cuentaNavidenaEsMensual": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        },
        "beneficiarioPorcentaje": {
          "data": {
            "1": {
              "rule": "NUM=",
              "value": "100",
              "when": "",
              "msj": "The sum of beneficiary percentages must equal 100%"
            }
          }
        }
      }
