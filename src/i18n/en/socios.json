      "validations": {
        "nombreCompleto": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "1",
              "msj": "Full name is required"
            }
          }
        },
        "nombrePublico": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Socially and/or publicly known as is required"
            }
          }
        },
        "tipoIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Identification type is required"
            }
          }
        },
        "numeroIdentificacion": {
          "data": {
