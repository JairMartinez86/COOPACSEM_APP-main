      "validations": {
        "nombreCompleto": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "1",
              "msj": "Full name is required"
            }
          }
        },
        "nombrePublico": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Known socially and/or publicly as is required"
            }
          }
        },
        "sexo": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Gender is required"
            }
          }
        },
        "estadoCivil": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Marital status is required"
            }
          }
        },
        "numeroInss": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "INSS number is required"
            }
          }
        },
        "tipoIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Identification type is required"
            }
          }
        },
        "numeroIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Identification number is required"
            },
            "2": {
              "rule": "REGEX",
              "when": "{tipoIdentificacion}='cedula' || {tipoIdentificacion}='residencia'",
              "value": "^[0-9]+[A-Za-z]$",
              "msj": "Only numbers and one letter at the end are allowed"
            },
            "3": {
              "rule": "LEN==",
              "when": "{tipoIdentificacion}='residencia' || {tipoIdentificacion}='cedula' ",
              "value": "14",
              "msj": "It must have exactly 14 characters"
            }
          }
        },
        "paisEmisor": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Issuing country is required"
            }
          }
        },
        "fechaEmision": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter a valid issue date"
            }
          }
        },
        "fechaVencimiento": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter a valid expiration date"
            }
          }
        },
        "paisNacimiento": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Country of birth is required"
            }
          }
        },
        "fechaNacimiento": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter a valid date of birth"
            }
          }
        },
        "nacionalidadId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Select a nationality"
            }
          }
        },
        "departamentoId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Select a department"
            }
          }
        },
        "municipioId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Select a municipality"
            }
          }
        },
        "direccionDomiciliar": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Enter an address"
            }
          }
        },
        "celular": {
          "data": {
            "1": {
              "rule": "REGEX",
              "when": "{telefono}=''",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "msj": "Enter a valid mobile phone number"
            }
          }
        },
        "telefono": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{celular}=''",
              "msj": "Enter a valid phone number"
            }
          }
        },
        "correo": {
          "data": {
            "1": {
              "rule": "EMAIL",
              "value": "",
              "when": "{correo}!=''",
              "msj": "Enter a valid email address"
            }
          }
        },
        "sociedadLabora": {
          "data": {
