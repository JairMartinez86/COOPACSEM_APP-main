    "form": {
      "fieldMeta": {
        "FechaInicio": {
          "label": "Deduction date",
          "tooltip": "Date when the Christmas account deduction will be applied",
          "tooltipIconClass": "bi bi-info-circle"
        },
        "MontoCuota": {
          "label": "Installment amount",
          "tooltip": "Amount scheduled for each installment in the plan",
          "tooltipIconClass": "bi bi-info-circle"
        },
        "Observacion": {
          "label": "Observation",
          "tooltip": "Optional note for the account opening",
          "tooltipIconClass": "bi bi-info-circle"
        }
      },
      "validations": {
        "FechaServidor": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": ""
            }
          }
        },
        "FechaInicio": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Enter the deduction date"
            },
            "2": {
              "rule": "DATE>=",
              "value": "{FechaServidor}",
              "when": "{yaAperturada}=false",
              "msj": "The date must be greater than or equal to the system date"
            },
            "3": {
              "rule": "YEAR=",
              "value": "YEAR({FechaServidor})",
              "when": "{yaAperturada}=false",
              "msj": "The year must match the system year"
            }
          }
        },
        "MontoCuota": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Enter the installment amount"
            },
            "2": {
              "rule": "NUM>",
              "value": "0",
              "when": "",
              "msj": "The installment amount must be greater than 0"
            }
          }
        },
        "Observacion": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        }
      }
    },
