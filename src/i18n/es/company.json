        "SmtpHost": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El servidor SMTP es requerido"
            }
          }
        },
        "SmtpPort": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El puerto SMTP es requerido"
            },
            "2": {
              "rule": "NUM>=",
              "value": "1",
              "when": "{SmtpPort}!=''",
              "msj": "El puerto SMTP debe ser mayor o igual a {value}"
            }
          }
        },
        "SmtpFrom": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El correo remitente es requerido"
