            "2": {
              "rule": "EMAIL",
              "when": "{SmtpFrom}!=''",
              "msj": "Ingrese un correo remitente válido"
            }
          }
        },
        "SmtpUsername": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El usuario SMTP es requerido"
