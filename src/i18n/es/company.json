      "validations": {
        "CompanyName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El nombre de la compañía es requerido"
            }
          }
        },
        "TradeName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El nombre comercial es requerido"
            }
          }
        },
        "Ruc": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El RUC es requerido"
            }
          }
        },
        "BusinessType": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un tipo de empresa"
            }
          }
        },
        "Status": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un estado"
            }
          }
        },
        "Description": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "La descripción es requerida"
            }
          }
        },
        "Phone": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{Phone}!=''",
              "msj": "Ingrese un número de teléfono válido"
            }
          }
        },
        "Mobile": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "when": "{Mobile}!=''",
              "msj": "Ingrese un número de celular válido"
            }
          }
        },
        "Email": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El correo electrónico es requerido"
            },
            "2": {
              "rule": "EMAIL",
              "when": "{Email}!=''",
              "msj": "Ingrese un correo electrónico válido"
            }
          }
        },
        "Website": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "El sitio web es requerido"
            }
          }
        },
        "Address": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "La dirección es requerida"
            }
          }
        },
        "Country": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un país"
            }
          }
        },
        "City": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "La ciudad es requerida"
            }
          }
        },
        "DateFormat": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un formato de fecha"
            }
          }
        },
        "Currency": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar una moneda"
            }
          }
        },
        "DecimalSeparator": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un separador decimal"
            }
          }
        },
        "ThousandSeparator": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Debes seleccionar un separador de miles"
            }
          }
        },
        "AffiliationCost": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "El monto de afiliacion debe de ser mayor a 0"
            }
          }
        },
        "OrdinaryCapitalPercentage": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "El porcentaje de capital ordinario debe de ser mayor o igual a 0"
            },
            "2": {
              "rule": "NUM({OtherDeferredIncomePercentage}+{OrdinaryCapitalPercentage})=",
              "value": "100",
              "when": "",
              "msj": "El porcentaje de capital ordinario y otros ingresos diferidos deben sumar 100"
            }
          }
        },
        "OtherDeferredIncomePercentage": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "when": "",
              "msj": "El porcentaje de otros ingresos diferidos debe de ser mayor o igual a 0"
            },
            "2": {
              "rule": "NUM({OtherDeferredIncomePercentage}+{OrdinaryCapitalPercentage})=",
              "value": "100",
              "when": "",
              "msj": "El porcentaje de capital ordinario y otros ingresos diferidos deben sumar 100"
            }
          }
        },
        "AffiliationAccount":{
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Ingrese la cuenta contable de afiliación"
            }
          }
        },
         "OrdinaryCapitalAccount":{
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Ingrese la cuenta contable de capital ordinario"
