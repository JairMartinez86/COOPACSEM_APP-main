          "label": "Configuración",
          "tooltip": "Campo opcional"
        },
        "Language": {
          "label": "Configuración",
          "tooltip": "Campo opcional"
        },
        "DefaultLandingPage": {
          "label": "Configuración",
          "tooltip": "Campo opcional"
        },
        "EnableTwoFactorLogin": {
          "label": "Configuración",
          "tooltip": ""
        },
        "Password": {
          "label": "Contraseña",
          "tooltip": "Campo requerido",
          "tooltipIconClass": "ri-key-2-line"
        },
        "NewPassword": {
          "label": "Contraseña",
          "tooltip": "Campo requerido",
          "tooltipIconClass": "ri-key-2-line"
        },
        "ConfirmPassword": {
          "label": "Contraseña",
          "tooltip": "Campo requerido",
          "tooltipIconClass": "ri-key-2-line"
        }
      },
      "validations": {
        "FullName": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "10",
              "msj": "El nombre debe tener al menos {value} caracteres"
            }
          }
        },
        "Email": {
          "data": {
            "1": {
              "rule": "EMAIL",
              "when": "{EnableTwoFactorLogin}=true || {Email}!=''",
              "msj": "Ingrese un correo válido"
            }
          }
        },
        "Mobile": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "when": "{Mobile}!=''",
              "msj": "Ingrese un número de celular válido"
            }
          }
        },
        "PhoneNumber": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{PhoneNumber}!=''",
              "msj": "Ingrese un número de teléfono válido"
            }
          }
        },
        "Address": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": ""
            }
          }
        },
        "Theme": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": ""
            }
          }
        },
        "Language": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": ""
            }
          }
        },
        "DefaultLandingPage": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": ""
            }
          }
        },
        "EnableTwoFactorLogin": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": ""
            }
          }
        },
        "Password": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{Password}!='' || {NewPassword}!='' || {ConfirmPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "NewPassword": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{NewPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "IGUAL",
              "value": "{ConfirmPassword}",
              "when": "{NewPassword}!='' && {ConfirmPassword}!=''",
              "msj": "Las contraseñas no coinciden",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "ConfirmPassword": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{ConfirmPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "IGUAL",
              "value": "{NewPassword}",
              "when": "{NewPassword}!='' && {ConfirmPassword}!=''",
              "msj": "Las contraseñas no coinciden",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        }
      }
    },
