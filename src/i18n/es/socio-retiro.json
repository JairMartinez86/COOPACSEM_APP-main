        "FechaSolicitud": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese una fecha válida"
            },
            "2": {
              "rule": "DATE=",
              "value": "{FechaServidor}",
              "when": "",
              "msj": "La fecha debe de ser igual al del servidor."
            }
          }
        },
        "TipoSolicitud": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "when": "",
              "value": 1,
              "msj": "Debe seleccionar el tipo de solicitud"
            }
          }
        },
        "Monto": {
          "data": {
            "1": {
              "rule": "NUM>",
              "when": "",
              "value": "0",
              "msj": "El monto debe ser mayor a 0"
            },
            "2": {
              "rule": "NUM<=",
              "when": "",
              "value": "{Ahorro}",
              "msj": "El monto debe ser menor o igual a {value}"
            }
          }
        },
