{
  "resetPassword": {
    "title": "Restablecer contraseña",
    "subtitle": "Elige una contraseña segura que no hayas usado antes.",
    "newPassword": "Nueva contraseña",
    "newPasswordPlaceholder": "Nueva contraseña",
    "confirmPassword": "Confirmar contraseña",
    "confirmPasswordPlaceholder": "Confirmar contraseña",
    "resetButton": "Restablecer contraseña",
    "backToLogin": "Regresar al login",
    "rights": "Todos los derechos reservados",
    "passwordsDoNotMatch": "Las contraseñas no coinciden.",
    "invalidToken": "El enlace de recuperación es inválido o ha expirado.",
    "remainingTime": "Tiempo restante:",
    "expired": "El enlace de recuperación ha expirado.",
    "form": {
      "fieldMeta": {
        "newPassword": {
          "label": "Contraseña",
          "tooltip": "Campo requerido"
        },
        "confirmPassword": {
          "label": "Contraseña",
          "tooltip": "Campo requerido"
        }
      },
      "validations": {
        "newPassword": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "La nueva contraseña es requerida"
            },
            "2": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{newPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "3": {
              "rule": "IGUAL",
              "value": "{confirmPassword}",
              "when": "{newPassword}!='' && {confirmPassword}!=''",
              "msj": "Las contraseñas no coinciden",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "confirmPassword": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "La confirmación de contraseña es requerida"
            },
            "2": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{confirmPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "3": {
              "rule": "IGUAL",
              "value": "{newPassword}",
              "when": "{newPassword}!='' && {confirmPassword}!=''",
              "msj": "Las contraseñas no coinciden",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        }
      }
    }
  }
}