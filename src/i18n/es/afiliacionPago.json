        "validations": {
          "Monto": {
            "data": {
              "1": {
                "rule": "NUM>",
                "value": "0",
                "msj": "Ingrese un monto mayor a 0"
              }
            }
          },
          "BancoCodigo": {
            "data": {
              "1": {
                "rule": "LEN>",
                "value": "0",
                "msj": "Seleccione un banco"
              }
            }
          },
          "NoDeposito": {
            "data": {
              "1": {
                "rule": "REGEX",
                "value": "^[0-9]+$",
                "msj": "Ingrese el número de depósito"
              }
            }
          },
          "FechaDeposito": {
            "data": {
              "1": {
                "rule": "REGEX",
                "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
                "when": "",
                "msj": "Ingrese una fecha válida"
              },
              "2": {
                "rule": "DATE<=",
                "value": "{FechaServidor}",
                "when": "",
                "msj": "La fecha debe de ser menor o igual al del servidor."
              }
            }
          },
          "Observacion": {
            "data": {
              "1": {
                "rule": "LEN>",
                "value": "0",
                "msj": "Ingrese una observación"
              }
            }
          }
        }
