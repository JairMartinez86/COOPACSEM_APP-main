          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^[0-9]+$",
              "msj": "Ingrese el número de depósito"
            }
          }
        },
        "FechaDeposito": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese una fecha válida"
            }
          }
        },
        "Observacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
