    "form": {
      "fieldMeta": {
        "FechaInicio": {
          "label": "Fecha de deducción",
          "tooltip": "Fecha en qque se va a deducir la cuenta navideña",
          "tooltipIconClass": "bi bi-info-circle"
        },
        "MontoCuota": {
          "label": "Monto de cuota",
          "tooltip": "Monto que se programará en cada cuota del plan",
          "tooltipIconClass": "bi bi-info-circle"
        },
        "Observacion": {
          "label": "Observación",
          "tooltip": "Comentario opcional para la apertura de la cuenta",
          "tooltipIconClass": "bi bi-info-circle"
        }
      },
      "validations": {
        "FechaServidor": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": ""
            }
          }
        },
        "FechaInicio": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese la fecha de deducción"
            },
            "2": {
              "rule": "DATE>=",
              "value": "{FechaServidor}",
              "when": "{yaAperturada}=false",
              "msj": "La fecha debe de ser mayor o igual a la del sistema"
            },
            "3": {
              "rule": "YEAR=",
              "value": "YEAR({FechaServidor})",
              "when": "{yaAperturada}=false",
              "msj": "El año debe coincidir con el año del sistema"
            }
          }
        },
        "MontoCuota": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "",
              "msj": "Ingrese el monto de cuota"
            },
            "2": {
              "rule": "NUM>",
              "value": "0",
              "when": "",
              "msj": "El monto de cuota debe ser mayor a 0"
            }
          }
        },
        "Observacion": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "when": "",
              "msj": ""
            }
          }
        }
      }
    },
