        "enableTwoFactorLogin": {
          "label": "Usuario",
          "tooltip": "Campo opcional",
          "tooltipIconClass": ""
        },
        "enableAuditEmailNotifications": {
          "label": "Activar notificaciones por correo",
          "tooltip": ""
        }
      },
      "validations": {
        "firstName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Campo requerido",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "lastName": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Campo requerido",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "email": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "when": "{enableTwoFactorLogin}=true",
              "msj": "El correo electrónico es requerido",
              "classIconSuccess": "",
              "classIconError": ""
            },
            "2": {
              "rule": "EMAIL",
              "when": "{enableTwoFactorLogin}=true || {enableAuditEmailNotifications}=true  || {email}!=''",
              "msj": "Ingrese un correo válido",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "role": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Seleccione un rol",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "password": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{password}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "LEN<=",
              "value": "100",
              "when": "{password}!=''",
              "msj": "La contraseña solo permite un máximo de {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "confirmPassword": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "6",
              "when": "{confirmPassword}!=''",
              "msj": "La contraseña debe tener al menos {value} caracteres",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            },
            "2": {
              "rule": "IGUAL",
              "value": "{password}",
              "when": "{password}!='' && {confirmPassword}!=''",
              "msj": "Las contraseñas no coinciden",
              "classIconSuccess": "ri-lock-star-fill",
              "classIconError": "ri-key-2-line"
            }
          }
        },
        "gender": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Seleccione un sexo",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "mobile": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "when": "{mobile}!=''",
              "msj": "Ingrese un número de celular válido"
            }
          }
        },
        "phoneNumber": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{phoneNumber}!=''",
              "msj": "Ingrese un número de teléfono válido"
            }
          }
        },
        "language": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Seleccione un idioma",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "address": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": "La dirección es requerida"
            }
          }
        },
        "theme": {
          "data": {
            "1": {
              "rule": "LEN>",
              "value": "0",
              "msj": "Seleccione un estilo visual",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "enableTwoFactorLogin": {
          "data": {
            "1": {
              "rule": "LEN>=",
              "value": "0",
              "msj": "",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        },
        "maxSessions": {
          "data": {
            "1": {
              "rule": "NUM>=",
              "value": "0",
              "msj": "Solo se permiten números positivos",
              "classIconSuccess": "",
              "classIconError": ""
            },
            "2": {
              "rule": "NUM<=",
              "value": "5",
              "msj": "No se permiten más de {value} sesiones activas",
              "classIconSuccess": "",
              "classIconError": ""
            }
          }
        }
      }
    },
