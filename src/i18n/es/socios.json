              "msj": "Seleccion eun tipo de identificación"
            }
          }
        },
        "conyugeNumeroIdentificacion": {
          "data": {
            "1": {
              "rule": "IF({estadoCivil}='casado' || {estadoCivil}='union_libre')->{3,4,5,6}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "2": {
              "rule": "IF(LEN({conyugeNumeroIdentificacion})>0)->{3,4,5,6}",
              "value": "0",
              "when": "",
              "msj": ""
            },
            "3": {
              "rule": "LEN>",
              "value": "0",
              "when": "{conyugeTipoIdentificacion} !='cedula'",
              "msj": "El número de identificación del cónyuge es requerido"
            },
            "4": {
              "rule": "IGUAL!=",
              "value": "{numeroIdentificacion}",
              "when": "{conyugeTipoIdentificacion}='cedula'",
              "msj": "El número de identificación del cónyuge no puede ser igual al del socio"
            },
            "5": {
              "rule": "REGEX",
              "when": "{conyugeTipoIdentificacion}='cedula' || {conyugeTipoIdentificacion}='residencia'",
              "value": "^[0-9]+[A-Za-z]$",
              "msj": "Solo se permiten números y una letra al final"
            },
            "6": {
              "rule": "LEN==",
              "when": "{conyugeTipoIdentificacion}='residencia' || {conyugeTipoIdentificacion}='cedula'",
              "value": "14",
              "msj": "Debe tener exactamente 14 caracteres"
            }
