      "validations": {
        "nombreCompleto": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "1",
              "msj": "El nombre completo es requerido"
            }
          }
        },
        "nombrePublico": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Conocido social y/o públicamente como, es requerido"
            }
          }
        },
        "sexo": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "El campo Sexo es requerido"
            }
          }
        },
        "estadoCivil": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "EL campo Estado Civil es requerido"
            }
          }
        },
        "numeroInss": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "EL No Inss requerido"
            }
          }
        },
        "tipoIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "El tipo de identificación es requerido"
            }
          }
        },
        "numeroIdentificacion": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "El número de identificación es requerido"
            },
            "2": {
              "rule": "REGEX",
              "when": "{tipoIdentificacion}='cedula' || {tipoIdentificacion}='residencia'",
              "value": "^[0-9]+[A-Za-z]$",
              "msj": "Solo se permiten números y una letra al final"
            },
            "3": {
              "rule": "LEN==",
              "when": "{tipoIdentificacion}='residencia' || {tipoIdentificacion}='cedula' ",
              "value": "14",
              "msj": "Debe tener exactamente 14 caracteres"
            }
          }
        },
        "paisEmisor": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "País emiso es requerido"
            }
          }
        },
        "fechaEmision": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese una fecha de emisión valida"
            }
          }
        },
        "fechaVencimiento": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese una fecha de vencimiento valida"
            }
          }
        },
        "paisNacimiento": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "El pais de nacimiento es requerido"
            }
          }
        },
        "fechaNacimiento": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^((\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))|((0[1-9]|[12]\\d|3[01])\\/(0[1-9]|1[0-2])\\/\\d{4})|((0[1-9]|1[0-2])\\/(0[1-9]|[12]\\d|3[01])\\/\\d{4}))$",
              "when": "",
              "msj": "Ingrese una fecha de vencimiento valida"
            }
          }
        },
        "nacionalidadId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Seleccione una nacionalidad"
            }
          }
        },
        "departamentoId": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Seleccion un departamento"
            }
          }
        },
        "municipioId": {
