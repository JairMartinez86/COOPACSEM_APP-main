              "msj": "Seleccion un municipio"
            }
          }
        },
        "direccionDomiciliar": {
          "data": {
            "1": {
              "rule": "LEN>",
              "when": "",
              "value": "0",
              "msj": "Ingrese una dirección"
            }
          }
        },
        "celular": {
          "data": {
            "1": {
              "rule": "REGEX",
              "when": "{telefono}=''",
              "value": "^\\+?[0-9]{1,4}([ -]?[0-9]{2,4}){2,4}$",
              "msj": "Ingrese un número de celular válido"
            }
          }
        },
        "telefono": {
          "data": {
            "1": {
              "rule": "REGEX",
              "value": "^\\+?[1-9][0-9\\s\\-]{6,18}$",
              "when": "{celular}=''",
              "msj": "Ingrese un número de teléfono válido"
            }
          }
        },
        "correo": {
          "data": {
            "1": {
              "rule": "EMAIL",
              "value": "",
              "when": "{correo}!=''",
              "msj": "Ingrese un correo válido"
            }
          }
        },
        "afiliacionCuotas": {
